---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCIE = [
  {
    date: "Abril 2026 - Actualmente",
    title: "Frontend Developer",
    company: "Deloitte",
    description: "Actualmente participo en un proyecto para Getnet, del grupo Banco Santander, desarrollando microfrontends para aplicaciones de backoffice y para clientes. Trabajo con Angular y Native Federation, creando módulos independientes, integrables y escalables, además de colaborar en su integración y en los procesos de despliegue. 💼💻🚀",
    link: "https://www2.deloitte.com/es/es.html",
  },
  {
    date: "Marzo 2025 - Abril 2026",
    title: "Junior Frontend",
    company: "Fútbol Emotion",
    description: "Desarrollo frontend de las webs de Fútbol Emotion, creando interfaces dinámicas con Angular y Server Side Rendering (SSR) para mejorar la experiencia de usuario y el rendimiento. ⚽🖥️🚀",
    link: "https://www.futbolemotion.com",
  },
  {
    date: "Junio 2023 - Marzo 2025",
    title: "Junior Delivery Analyst",
    company: "Deloitte",
    description: "Desarrollando una aplicación web para el ayuntamiento de una destacada ciudad en los Países Bajos, enfocado en el desarrollo frontend con React.js, trabajando en componentes reutilizables y buenas prácticas. 💼💻🏛️",
    link: "https://www2.deloitte.com/es/es.html",
  },
  {
    date: "Marzo 2023",
    title: "Frontend Intern",
    company: "CrossControl Oy Fi",
    description:
      "Como becario, participé en el desarrollo de una aplicación web para el monitoreo de cámaras de seguridad con detección de personas mediante inteligencia artificial usando React.js. En Tampere, Finlandia, para una empresa especializada en la distribución de pantallas para vehículos industriales.👁️‍🗨️🚚",
  },
]
---

<ol class="experience-list relative mt-16">
  {
    EXPERIENCIE.map((experiencie) => (
      <li data-reveal>
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
