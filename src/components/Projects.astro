---
import GitHub from "./icons/GitHub.astro"
import Tailwind from "./icons/Tailwind.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Angular from "./icons/Angular.astro"
import PrimeFlex from "./icons/PrimeFlex.astro"
import Rxjs from "./icons/Rxjs.astro"
import ReactJS from "./icons/ReactJS.astro"
import Redux from "./icons/Redux.astro"
import CodeIcon from "./icons/Code.astro"

const TAGS = {
  ANGULAR: {
    name: "Angular 17",
    class: "project-tag--technology",
    icon: Angular,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "project-tag--technology",
    icon: Tailwind,
  },
  PRIMEFLEX: {
    name: "PrimeFlex",
    class: "project-tag--technology",
    icon: PrimeFlex,
  },
  RXJS: {
    name: "RxJS",
    class: "project-tag--technology",
    icon: Rxjs,
  },
  REACT: {
    name: "React.js",
    class: "project-tag--technology",
    icon: ReactJS,
  },
  REDUX: {
    name: "Redux",
    class: "project-tag--technology",
    icon: Redux,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "project-tag--technology",
    icon: CodeIcon,
  },
}
const PROJECTS = [
  {
    title: "FUEL APP",
    description:
      "SPA desarrollada con React y TypeScript para consultar los precios de las gasolineras en España y encontrar las opciones más baratas según tu ubicación. Consume la API oficial del Ministerio, permite filtrar por combustible y zona, calcula distancias y utiliza virtualización para manejar grandes volúmenes de estaciones. ⛽📍",
    link: "https://cebrianalvaro9.github.io/fuel-app/",
    github: "https://github.com/CebrianAlvaro9/fuel-app",
    image: "/porfolioWebAlvaroCebrian/projects/fuelApp.png",
    featured: true,
    tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND],
  },
  {
    title: "POKEDEX-APP",
    description:
      "Desarrollo de un proyecto que permite a los usuarios explorar la Pokédex completa con detalles exhaustivos por Pokémon y consultar todos los ítems de la Pokédex, utilizando la PokeAPI y tecnologías avanzadas como RxJS para un manejo eficiente y dinámico de datos. Angular17-Rxjs",
    link: "https://pokemonapp-45e99.firebaseapp.com/home",
    github: "https://github.com/victorpowah/pokemonApp",
    image: "/porfolioWebAlvaroCebrian/projects/pokemonApp.PNG",
    tags: [TAGS.ANGULAR, TAGS.PRIMEFLEX, TAGS.RXJS],
  },
  {
    title: "ECOMMERCE",
    description:
      "Desarrollo en marcha: Plataforma de compras online en construcción con un listado de productos, filtros versátiles, paginacion y carrito de compras. Implementación con React.js con Typescript, useContext, useReducer para una experiencia de compra avanzada y eficiente. 🛒💻",
    link: "https://cebrianalvaro9.github.io/OnlineShop/",
    github: "https://github.com/CebrianAlvaro9/OnlineShop",
    image: "/porfolioWebAlvaroCebrian/projects/OnlineShop.png",
    tags: [TAGS.REACT,TAGS.REDUX, TAGS.TAILWIND],
  },
]
---

<div class="projects-list flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github, featured }) => (
    <article
      class={`project-card flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 ${featured ? "project-card--fuel" : ""}`}
      data-reveal
      data-card-tilt
    >
  <div class="w-full md:w-1/2">
            <div class="project-media relative overflow-clip">
      <img alt={title} class="project-image" loading={title === "FUEL APP" ? "eager" : "lazy"} src={image} />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
    <h3 class="project-title text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <div class="flex flex-wrap mt-2">
      <ul class="flex flex-row mb-2 gap-x-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`project-tag flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

      <div class="project-description mt-2 text-gray-700 dark:text-gray-400">{description}</div>
      <footer class="project-actions flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <GitHub class="size-6" />
              Code
              
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link}>
              <Link class="size-4" />
              Preview
            </LinkButton>
          )}
        </footer>
    </div>
  </div>
</article>
    ))
  }
</div>
