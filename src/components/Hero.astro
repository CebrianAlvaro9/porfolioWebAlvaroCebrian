---
const personalImageAlt = "Alvaro Cebrian"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="hero-layout">
  <div class="hero-copy">
    <div class="hero-intro">
      <span class="hero-avatar">
        <img
          src="/porfolioWebAlvaroCebrian/avatar.png"
          alt={personalImageAlt}
        />
      </span>
      <a
        href="https://www.linkedin.com/in/alvaro-cebrian-urue%C3%B1a-810249265/"
        target="_blank"
        rel="noopener"
        class="hero-status"
      >
        <Badge>Disponible</Badge>
      </a>
    </div>
    <p class="hero-overline">SOFTWARE ENGINEER <span>/</span> FRONTEND</p>
    <h1>Hey, soy <span>Alvaro!</span></h1>
    <p class="hero-description">
      Ingeniero de software con más de 3 años de experiencia. <strong
        >Frontend developer</strong
      > de Zaragoza, España 🇪🇸, especializado en crear interfaces escalables y experiencias web modernas con Angular y React.
    </p>
    <nav class="hero-actions" aria-label="Contacto y redes sociales">
      <SocialPill href="mailto:cebrianalvaro9@gmail.com">
        <MailIcon class="size-4" />
        Contáctame
      </SocialPill>
      <SocialPill href="https://www.linkedin.com/in/alvaro-cebrian-urue%C3%B1a-810249265/">
        <LinkedInIcon class="size-4" />
        LinkedIn
      </SocialPill>
    </nav>
  </div>

  <div class="hero-showcase" aria-hidden="true">
    <div class="hero-showcase__halo"></div>
    <div class="hero-showcase__ring hero-showcase__ring--one"></div>
    <div class="hero-showcase__ring hero-showcase__ring--two"></div>
    <div class="hero-showcase__card">
      <img src="/porfolioWebAlvaroCebrian/avatar.png" alt="" />
      <span>SCROLL TO EXPLORE</span>
    </div>
    <span class="hero-showcase__index">01 / 04</span>
  </div>
</div>
