---
import Badge from "@/components/Badge.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import SocialPill from "@/components/SocialPill.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"

import Layout from "@/layouts/Layout.astro"
---

<Layout
  title="Design System porfolio.dev"
  description="El catálogo de componentes de nuestro porfolio"
>
  <main class="components-page px-4">
  <SectionContainer class="components-showcase py-44 pb-32 flex flex-col gap-y-10" data-reveal>
    <article class="component-card mb-10" data-reveal>
      <h1 class="component-title mb-4 text-xl font-semibold">&lt;Badge /&gt;</h1>

      <Badge>Disponible</Badge>
    </article>

    <article class="component-card mb-10" data-reveal>
      <h1 class="component-title mb-4 text-xl font-semibold">&lt SocialPill /&gt;</h1>

      <div class="flex">
        <SocialPill href="https://linkedin.com/in/midudev">
          <LinkedInIcon class="size-4 md:size-6" />
          LinkedIn
        </SocialPill>
      </div>
    </article>
  </SectionContainer>
  </main>
</Layout>
