---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import Experience from "@/components/Experience.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
---

<Layout
  title="Porfolio Alvaro Cebrian"
  description=""
>
  <main class="portfolio-main px-4">
    <SectionContainer
      class="hero-section py-16 md:py-36"
      data-scroll-hero
      data-reveal
    >
      <Hero />
    </SectionContainer>
    <div class="sections-stack space-y-24">
    <SectionContainer id="experiencia" data-reveal>
      <h2
        class="section-heading flex items-center mb-6 gap-x-3"
      >
        <Briefcase class="size-8" />
        Experiencia laboral
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id="proyectos" data-reveal>
      <h2
        class="section-heading flex items-center mb-6 gap-x-3"
      >
        <CodeIcon class="size-7" />
        Proyectos
      </h2>
      <Projects />
    </SectionContainer>

    <SectionContainer id="sobre-mi" data-reveal>
      <h2
        class="section-heading flex items-center mb-6 gap-x-8"
      >
        <ProfileCheck class="size-8" />
        Sobre mí
      </h2>
      <AboutMe />
    </SectionContainer>
  </div>
  </main>
</Layout>
