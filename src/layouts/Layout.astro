---
import "@fontsource-variable/onest"
import "../styles/global.css"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import ScrollEffects from "../components/ScrollEffects.astro"
import { ClientRouter } from "astro:transitions"

interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/porfolioWebAlvaroCebrian/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body>
    <div class="site-ambient" aria-hidden="true">
      <span class="ambient-orb ambient-orb--one"></span>
      <span class="ambient-orb ambient-orb--two"></span>
      <span class="ambient-grid"></span>
    </div>
    <Header />
    <slot />
    <Footer />
    <ScrollEffects />
  </body>
</html>
